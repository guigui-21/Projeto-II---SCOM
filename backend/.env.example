# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enciclopedia_aliens
DB_USER=root
DB_PASS=

# true mostra detalhes técnicos nos erros 500 (use só em desenvolvimento)
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

# Limite de tentativas de login (por IP + e-mail)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600
